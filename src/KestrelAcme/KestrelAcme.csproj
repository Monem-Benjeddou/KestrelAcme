<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>KestrelAcme</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>KestrelAcme</PackageId>
    <Description>Automatic HTTPS for ASP.NET Core: issues and renews Let's Encrypt (ACME) certificates for Kestrel, in-process. HTTP-01, TLS-ALPN-01 and DNS-01 challenges (wildcard certificates), ARI renewal windows and certificate swaps without restart. Windows, Linux and macOS.</Description>
    <PackageTags>acme;letsencrypt;https;tls;ssl;certificate;wildcard;dns-01;kestrel;aspnetcore</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KestrelAcme.Tests" />
    <InternalsVisibleTo Include="KestrelAcme.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
